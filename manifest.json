{
  "manifest_version": 3,
  "name": "Agentic EQ Reply — Professional Communications Assistant",
  "short_name": "Agentic EQ Reply",
  "version": "1.0.0",
  "description": "Draft emotionally intelligent, executive replies for email and chat with RAG-grounded multi-agent EQ protocols.",
  "homepage_url": "https://github.com/Sahasspok/Emotional-Intelligent-Agent",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "lib/icons/icon16.png",
    "32": "lib/icons/icon32.png",
    "48": "lib/icons/icon48.png",
    "128": "lib/icons/icon128.png"
  },
  "action": {
    "default_title": "Open Agentic EQ Reply Assistant",
    "default_icon": {
      "16": "lib/icons/icon16.png",
      "32": "lib/icons/icon32.png",
      "48": "lib/icons/icon48.png",
      "128": "lib/icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*",
        "*://*.slack.com/*",
        "*://*.linkedin.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*",
        "*://teams.microsoft.com/*",
        "*://*.discord.com/*",
        "*://*.notion.so/*",
        "*://*.zendesk.com/*",
        "*://*.jira.com/*",
        "*://*.atlassian.net/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.mistral.ai/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/rag/corpus.json",
        "lib/rag/index.json",
        "lib/icons/*"
      ],
      "matches": [
        "*://mail.google.com/*",
        "*://*.slack.com/*",
        "*://*.linkedin.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*",
        "*://teams.microsoft.com/*",
        "*://*.discord.com/*",
        "*://*.notion.so/*",
        "*://*.zendesk.com/*",
        "*://*.jira.com/*",
        "*://*.atlassian.net/*"
      ]
    }
  ],
  "commands": {
    "open_app": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open Agentic EQ Reply Assistant in Full Tab"
    },
    "quick_draft": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Draft Quick EQ Reply from Selected Text"
    }
  }
}
